msgstr[0] "бионическая шина для рук"
msgstr[1] "бионические шины для рук"
msgstr[2] "бионических шин для рук"

#. ~ Description for {'str': 'bionic arm splint'}
#. ~ Description for {'str': 'bionic leg splint'}
#: .\items\advtech\sq_nano_tier.json
msgid "Advanced splint. Less restrictive on limb movement, and quickly immobilizes broken bones."
msgstr "Усовершенствованная шина, которая меньше ограничивает движения конечности и быстро фиксирует сломанные кости."

#: .\items\advtech\sq_nano_tier.json
