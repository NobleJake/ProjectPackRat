msgid "A special mutagenic serum designed to give you a single mutation. Heightens dopamine production when killing something and as a result of that makes you crave it."
msgstr "Особая мутагенная сыворотка, вызывающая одну определённую мутацию. Эта усилит выработку дофамина при убийстве, постепенно вызывая тягу к нему."

#: .\mutations\item.json
msgid "Weak scent serum"
msgid_plural "Weak scent serums"
msgstr[0] "сыворотка слабого запаха"
