#. ~ Description for {'str': 'TV-110 armored rig'}
#: .\items\item_common\sq_mil_armor.json
msgid "A heavy-duty chest rig with integrated armor plates. Excellent protection and carrying capacity."
msgstr "Тяжёлая разгрузочная система со встроенными бронеплитами. Обеспечивает отличную защиту и позволяет носить с собой большое количество снаряжения."

#: .\items\item_common\sq_mil_armor.json
msgid "AVS armored vest"
msgid_plural "AVS armored vests"
msgstr[0] "бронеразгрузка AVS"
msgstr[1] "бронеразгрузки AVS"
msgstr[2] "бронеразгрузок AVS"

#. ~ Description for {'str': 'AVS armored vest'}
