msgstr[1] "сыворотки крепкого сна"
msgstr[2] "сывороток крепкого сна"

#. ~ Description for Heavy sleeper serum
#: .\mutations\item.json
msgid "A special mutagenic serum designed to give you a single mutation. Lowers your environmental reactivity while asleep."
msgstr "Особая мутагенная сыворотка, вызывающая одну определённую мутацию. Эта снизит вашу восприимчивость к внешним раздражителям во время сна."

#: .\mutations\item.json
msgid "Albinism serum"
msgid_plural "Albinism serums"
msgstr[0] "сыворотка альбинизма"
msgstr[1] "сыворотки альбинизма"
msgstr[2] "сывороток альбинизма"

