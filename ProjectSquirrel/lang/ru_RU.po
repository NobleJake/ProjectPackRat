#: .\items\item_common\sq_suit.json
msgid "advanced nomad suit"
msgid_plural "advanced nomad suits"
msgstr[0] "улучшенный костюм кочевника"
msgstr[1] "улучшенных костюма кочевника"
msgstr[2] "улучшенных костюмов кочевника"

#. ~ Use action msg for {'str': 'advanced nomad suit'}.
#: .\items\item_common\sq_suit.json
msgid "You turn the climate control on."
msgstr "Вы включаете климат-контроль."

#. ~ Description for {'str': 'advanced nomad suit'}
#: .\items\item_common\sq_suit.json
msgid "A reinforced but airy jumpsuit designed to survive the long-term wear and tear of exploring the apocalyptic wasteland.  Rather than advanced polymer fabrics which may not be available in many worlds, it is made of breathable twill fabric with leather reinforcements ensuring it can be produced easily regardless of technology level.  Its clever construction adds additional core support, helping you to carry more equipment.  A set of cooling tubes run throughout the clothing as well."
msgstr "Усиленный, но хорошо вентилируемый комбинезон, рассчитанный на долгие странствия по постапокалиптическим пустошам. Вместо современных полимерных тканей, которые доступны далеко не в каждом мире, он изготовлен из дышащей саржи с кожаными усилениями, поэтому его легко сделать даже при невысоком уровне технологий. Продуманная конструкция дополнительно поддерживает корпус и позволяет переносить больше снаряжения. По всему костюму также проложена система охлаждающих трубок."

